@model SAtS_MVC_Client.Models.Teacher

@{
    // Restyled to match the home page: details in a card
    ViewData["Title"] = "Delete Teacher";
}

<div class="sats-page-head">
    <p class="sats-eyebrow">Teacher Records</p>
    <h1>Delete Teacher</h1>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="alert alert-warning">
            Are you sure you want to delete this teacher? This can't be undone.
        </div>
        <div class="sats-form-card">
            <div class="sats-card-head">
                <span class="sats-card-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                <h2>Details</h2>
            </div>
            <dl class="sats-details">
            <div>
                <dt>@Html.DisplayNameFor(model => model.TeacherFname)</dt>
                <dd>@Html.DisplayFor(model => model.TeacherFname)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.TeacherLname)</dt>
                <dd>@Html.DisplayFor(model => model.TeacherLname)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.TeacherEmail)</dt>
                <dd>@Html.DisplayFor(model => model.TeacherEmail)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.TeacherPhone)</dt>
                <dd>@Html.DisplayFor(model => model.TeacherPhone)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.TeacherDepartment)</dt>
                <dd>@Html.DisplayFor(model => model.TeacherDepartment)</dd>
            </div>
            </dl>
            <form asp-action="Delete" method="post" class="sats-form-actions">
                <input type="hidden" asp-for="TeacherId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>
