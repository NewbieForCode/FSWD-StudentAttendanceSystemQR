@model SAtS_MVC_Client.Models.MyAttendanceViewModel

@{
    // Caleb McIntyre - 12/11/2026
    // A student's own attendance report, one row per course
    // Caleb McIntyre - 13/11/2026: restyled as cards to match the home page
    ViewData["Title"] = "My Attendance";
}

<div class="sats-page-head">
    <p class="sats-eyebrow">Student</p>
    <h1>My Attendance</h1>
    @if (ViewBag.Message == null)
    {
        <h3>@Model.StudentName</h3>
    }
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning"> @ViewBag.Message </div>
}
else
{
    <div class="sats-panel d-flex flex-wrap align-items-center gap-4 mb-4">
        <div class="sats-stat">@Model.OverallPercentage%</div>
        <div>
            <strong class="d-block fs-5">Overall attendance</strong>
            <span class="text-secondary">You've attended @Model.AttendedSessions of @Model.TotalSessions sessions.</span>
        </div>
    </div>

    @if (Model.Courses.Count == 0)
    {
        <p> There are no course sessions yet. </p>
    }
    else
    {
        <h2 class="h3 text-body mb-3" style="font-weight: 800;">By course</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var course in Model.Courses)
            {
                //Green from 80%, amber from 50%, otherwise red
                var barColour = course.Percentage >= 80 ? "bg-success"
                              : course.Percentage >= 50 ? "bg-warning"
                              : "bg-danger";
                <div class="col">
                    <div class="sats-form-card h-100">
                        <div class="sats-card-head mb-3">
                            <span class="sats-card-icon"><i class="bi bi-book" aria-hidden="true"></i></span>
                            <div>
                                <div class="sats-card-title">@course.CourseId</div>
                                <div class="text-secondary">@course.CourseName</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="fs-4 fw-bold">@course.Percentage%</span>
                            <span class="text-secondary">@course.AttendedSessions of @course.TotalSessions sessions</span>
                        </div>
                        <div class="progress sats-progress" role="progressbar" aria-label="@course.CourseId attendance" aria-valuenow="@course.Percentage" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @barColour" style="width: @course.Percentage%"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
