@model SAtS_MVC_Client.Models.Student

@{
    // Restyled to match the home page: details in a card
    ViewData["Title"] = "Delete Student";
}

<div class="sats-page-head">
    <p class="sats-eyebrow">Student Records</p>
    <h1>Delete Student</h1>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="alert alert-warning">
            Are you sure you want to delete this student? This can't be undone.
        </div>
        <div class="sats-form-card">
            <div class="sats-card-head">
                <span class="sats-card-icon"><i class="bi bi-person" aria-hidden="true"></i></span>
                <h2>Details</h2>
            </div>
            <dl class="sats-details">
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentFName)</dt>
                <dd>@Html.DisplayFor(model => model.StudentFName)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentLName)</dt>
                <dd>@Html.DisplayFor(model => model.StudentLName)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentDob)</dt>
                <dd>@Html.DisplayFor(model => model.StudentDob)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentStreetAddress)</dt>
                <dd>@Html.DisplayFor(model => model.StudentStreetAddress)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentSuburb)</dt>
                <dd>@Html.DisplayFor(model => model.StudentSuburb)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentCity)</dt>
                <dd>@Html.DisplayFor(model => model.StudentCity)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentPostalCode)</dt>
                <dd>@Html.DisplayFor(model => model.StudentPostalCode)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentEmail)</dt>
                <dd>@Html.DisplayFor(model => model.StudentEmail)</dd>
            </div>
            <div>
                <dt>@Html.DisplayNameFor(model => model.StudentPhone)</dt>
                <dd>@Html.DisplayFor(model => model.StudentPhone)</dd>
            </div>
            </dl>
            <form asp-action="Delete" method="post" class="sats-form-actions">
                <input type="hidden" asp-for="StudentId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>
