@model SAtS_MVC_Client.Models.SessionQrViewModel

@{
    // Caleb McIntyre - 12/11/2026
    // Teacher page: shows the session's QR code for students to scan.
    // The QR image is generated by the external goQR.me API.
    // Caleb McIntyre - 13/11/2026: restyled to match the home page
    ViewData["Title"] = "Check-in QR Code";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success"> @TempData["Message"] </div>
}

<div class="sats-panel text-center py-4 py-md-5">
    <p class="sats-eyebrow">Session on @Model.Session.CSessionDate.ToString("dddd d MMMM yyyy")</p>
    <h1>@Model.Session.CourseId - @Model.Session.CourseName</h1>
    <p class="sats-page-text mb-4">Scan this code to check in.</p>

    <img src="@Model.QrImageUrl" alt="QR code to check in to this session" width="300" height="300" class="sats-qr mb-3" />

    <p class="mb-2">
        <small class="text-secondary"> Or open: <a href="@Model.CheckInUrl" class="text-break">@Model.CheckInUrl</a> </small>
    </p>
    <p class="fs-5"> Students checked in so far: <strong>@Model.Session.CheckedInCount</strong> </p>

    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-primary" asp-action="SessionAttendance" asp-route-id="@Model.Session.CSessionId">View Attendance</a>
        <a class="btn btn-secondary" asp-action="Sessions">Back to sessions</a>
    </div>
</div>
