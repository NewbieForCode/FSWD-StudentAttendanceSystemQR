@model SAtS_MVC_Client.Models.SessionQrViewModel

@{
    // Caleb McIntyre - 12/11/2026
    // Teacher page: shows the session's QR code for students to scan.
    // The QR image is generated by the external goQR.me API.
    ViewData["Title"] = "Check-in QR Code";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success"> @TempData["Message"] </div>
}

<div class="text-center">
    <h1> @Model.Session.CourseId - @Model.Session.CourseName </h1>
    <h3> Session on @Model.Session.CSessionDate.ToString("dd/MM/yyyy") </h3>
    <p class="lead"> Scan this code to check in. </p>

    <img src="@Model.QrImageUrl" alt="QR code to check in to this session" width="300" height="300" class="img-fluid border p-2 mb-3" />

    <p>
        <small class="text-muted"> Or open: <a href="@Model.CheckInUrl">@Model.CheckInUrl</a> </small>
    </p>

    <p> Students checked in so far: <strong>@Model.Session.CheckedInCount</strong> </p>

    <a class="btn btn-primary" asp-action="SessionAttendance" asp-route-id="@Model.Session.CSessionId">View Attendance</a>
    <a class="btn btn-secondary" asp-action="Sessions">Back to sessions</a>
</div>
