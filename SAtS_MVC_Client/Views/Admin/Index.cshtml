@model List<SAtS_MVC_Client.Models.AdminUserViewModel>

@{
    // Caleb McIntyre - 12/11/2026
    // Admin page: list of user accounts and their roles
    ViewData["Title"] = "Admin - Users";
}

@* Caleb McIntyre - 13/11/2026: heading and table box match the home page *@
<div class="sats-page-head">
    <p class="sats-eyebrow">Admin</p>
    <h1>Users and Roles</h1>
</div>

<div class="mb-4">
    <h5> Manage content </h5>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Student" asp-action="Index">Student Records</a>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Course" asp-action="Index">Course Records</a>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="CheckIn" asp-action="Sessions">Course Sessions</a>
</div>

<h3> User Accounts </h3>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success"> @TempData["Message"] </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"> @TempData["Error"] </div>
}

<div class="table-responsive sats-table-wrap">
    @* Caleb McIntyre - 13/11/2026: header and body sections (fixes the stripe colours) and an Actions heading *@
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th> Email </th>
                <th> Full Name </th>
                <th> Confirmed </th>
                <th> Roles </th>
                <th> Actions </th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td> @user.Email </td>
                <td> @user.FullName </td>
                <td> @(user.EmailConfirmed ? "Yes" : "No") </td>
                <td>
                    @if (user.Roles.Count == 0)
                    {
                        <span class="text-muted">None</span>
                    }
                    @foreach (var role in user.Roles)
                    {
                        <span class="badge bg-secondary"> @role </span>
                    }
                </td>
                <td class="text-nowrap">
                    <a class="btn btn-primary btn-sm" asp-action="ManageRoles" asp-route-id="@user.Id">Edit Roles</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@user.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
