@model SAtS_MVC_Client.Models.ManageRolesViewModel

@{
    // Caleb McIntyre - 12/11/2026
    // Admin page: tick the roles a user should have
    // Caleb McIntyre - 13/11/2026: restyled to match the home page
    ViewData["Title"] = "Admin - Edit Roles";
}

<div class="sats-page-head">
    <p class="sats-eyebrow">Admin</p>
    <h1>Edit Roles</h1>
    <h3> @Model.Email @(string.IsNullOrEmpty(Model.FullName) ? "" : "(" + Model.FullName + ")") </h3>
</div>

<div class="row">
    <div class="col-md-7 col-lg-5">
        <form asp-action="ManageRoles" method="post" class="sats-form-card">
            <div class="sats-card-head">
                <span class="sats-card-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                <h2>Roles</h2>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="FullName" />

            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <div class="form-check fs-5 mb-2">
                    <input type="hidden" asp-for="Roles[i].RoleName" />
                    <input class="form-check-input" asp-for="Roles[i].IsSelected" />
                    <label class="form-check-label" asp-for="Roles[i].IsSelected"> @Model.Roles[i].RoleName </label>
                </div>
            }

            <div class="sats-form-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
