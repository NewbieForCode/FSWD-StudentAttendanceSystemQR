@model SAtS_MVC_Client.Models.AdminUserViewModel

@{
    // Caleb McIntyre - 12/11/2026
    // Admin page: confirm before deleting a user account
    ViewData["Title"] = "Admin - Delete User";
}

<h1> Delete User </h1>

<div class="alert alert-warning">
    Are you sure you want to delete this account? This can't be undone.
</div>

<dl class="row">
    <dt class="col-sm-3"> Email </dt>
    <dd class="col-sm-9"> @Model.Email </dd>
    <dt class="col-sm-3"> Full Name </dt>
    <dd class="col-sm-9"> @Model.FullName </dd>
    <dt class="col-sm-3"> Roles </dt>
    <dd class="col-sm-9"> @string.Join(", ", Model.Roles) </dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
