@model SAtS_MVC_Client.Models.AdminUserViewModel

@{
    // Caleb McIntyre - 12/11/2026
    // Admin page: confirm before deleting a user account
    // Caleb McIntyre - 13/11/2026: restyled to match the home page
    ViewData["Title"] = "Delete User";
}

<div class="sats-page-head">
    <p class="sats-eyebrow">Admin</p>
    <h1>Delete User</h1>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="alert alert-warning">
            Are you sure you want to delete this account? This can't be undone.
        </div>
        <div class="sats-form-card">
            <div class="sats-card-head">
                <span class="sats-card-icon"><i class="bi bi-person-x" aria-hidden="true"></i></span>
                <h2>Details</h2>
            </div>
            <dl class="sats-details">
            <div>
                <dt>Email</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>Full Name</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>Roles</dt>
                <dd>@string.Join(", ", Model.Roles)</dd>
            </div>
            </dl>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="sats-form-actions">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>
