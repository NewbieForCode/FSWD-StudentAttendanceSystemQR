@model SAtS_MVC_Client.Models.CourseSession

<h1>Edit Course Session</h1>

<form asp-action="EditSession" method="post">

    <input type="hidden" asp-for="CSessionId" />

    <div class="form-group">
        <label asp-for="CourseId">Course ID</label>
        <input asp-for="CourseId" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CSessionDate">Session Date</label>
        <input asp-for="CSessionDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CSessionQrtoken">QR Token</label>
        <input asp-for="CSessionQrtoken" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>

</form>