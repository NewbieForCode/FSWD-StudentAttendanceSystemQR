@model SAtS_MVC_Client.Models.Course

@{
    // Caleb McIntyre - 12/11/2026: Admin page to confirm deleting a course
    // Caleb McIntyre - 13/11/2026: restyled to match the home page
    ViewData["Title"] = "Delete Course";
}

<div class="sats-page-head">
    <p class="sats-eyebrow">Course Records</p>
    <h1>Delete Course</h1>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-7">
        <div class="alert alert-warning">
            Are you sure you want to delete this course? This can't be undone.
        </div>
        <div class="sats-form-card">
            <div class="sats-card-head">
                <span class="sats-card-icon"><i class="bi bi-book" aria-hidden="true"></i></span>
                <h2>Details</h2>
            </div>
            <dl class="sats-details">
            <div>
                <dt>Course ID</dt>
                <dd>@Model.CourseId</dd>
            </div>
            <div>
                <dt>Course Name</dt>
                <dd>@Model.CourseName</dd>
            </div>
            </dl>
            <form asp-action="Delete" asp-route-id="@Model.CourseId" method="post" class="sats-form-actions">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>
