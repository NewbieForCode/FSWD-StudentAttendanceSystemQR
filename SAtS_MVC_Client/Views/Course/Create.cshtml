@model SAtS_MVC_Client.Models.Course

@{
    // Caleb McIntyre - 12/11/2026: Admin page to add a course
    ViewData["Title"] = "Add Course";
}

<h1> Add Course </h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CourseId" class="form-label"></label>
                <input asp-for="CourseId" class="form-control" placeholder="e.g. FS101" />
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CourseName" class="form-label"></label>
                <input asp-for="CourseName" class="form-control" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Add</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
