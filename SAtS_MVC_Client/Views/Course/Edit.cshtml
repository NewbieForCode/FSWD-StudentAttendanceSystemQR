@model SAtS_MVC_Client.Models.Course

@{
    // Caleb McIntyre - 12/11/2026: Admin page to edit a course's name
    // Caleb McIntyre - 13/11/2026: restyled to match the home page
    ViewData["Title"] = "Edit Course";
}

<div class="sats-page-head">
    <p class="sats-eyebrow">Course Records</p>
    <h1>Edit Course</h1>
</div>

<div class="row">
    <div class="col-lg-7 col-xl-6">
        <form asp-action="Edit" asp-route-id="@Model.CourseId" method="post" class="sats-form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CourseId" class="form-label"></label>
                <input asp-for="CourseId" class="form-control" readonly />
                <div class="form-text">The course ID can't be changed.</div>
            </div>

            <div class="mb-3">
                <label asp-for="CourseName" class="form-label"></label>
                <input asp-for="CourseName" class="form-control" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TeacherId" class="form-label">Assigned Teacher</label>
                <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-select">
                    <option value="">Select a Teacher</option>
                </select>
            </div>

            <div class="sats-form-actions">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
