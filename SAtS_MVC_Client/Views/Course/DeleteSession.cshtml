@model SAtS_MVC_Client.Models.CourseSession

<h1>Delete Course Session</h1>

<p>Are you sure you want to delete this session?</p>

<dl>
    <dt>Session ID</dt>
    <dd>@Model.CSessionId</dd>

    <dt>Course ID</dt>
    <dd>@Model.CourseId</dd>

    <dt>Session Date</dt>
    <dd>@Model.CSessionDate</dd>
</dl>

<form asp-action="DeleteSessionConfirmed" method="post">
    <input type="hidden" name="id" value="@Model.CSessionId" />

    <button type="submit" class="btn btn-danger">Confirm Delete</button>

    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>