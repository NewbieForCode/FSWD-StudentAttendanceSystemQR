@model List<SAtS_MVC_Client.Models.CourseViewModel>

<h1> Course Records </h1>
<h3> Current courses offered by the university.</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Course Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course.CourseId</td>
                <td>@item.Course.CourseName</td>
            </tr>
        }
    </tbody>
</table>


<br /> <br />
<h1> Course Sessions </h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Session ID</th>
            <th>Session Date</th>
            <th>QR Token</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            @foreach (var session in item.Sessions)
            {
                // Testing QR Code gen for the sessions 
                string qrContent = $"https://localhost:7147/api/CourseSession/{session.CSessionId}/qrcode";
                string qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={Uri.EscapeDataString(qrContent)}";
                <tr>
                    <td>@session.CourseId</td>
                    <td>@session.CSessionId</td>
                    <td>@session.CSessionDate</td>
                    <td>@session.CSessionQrtoken</td>
                    <td><img src="@qrUrl" alt="QR Code" width="30" height="30" /></td>
                </tr>
            }
        }
        
    </tbody>
</table>

