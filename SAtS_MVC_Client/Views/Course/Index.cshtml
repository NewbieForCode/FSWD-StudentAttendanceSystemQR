@model List<SAtS_MVC_Client.Models.CourseViewModel>

@{
    // Caleb McIntyre - 12/11/2026: Admins see Add, Edit and Delete buttons
    ViewData["Title"] = "Course Records";
    var isAdmin = User.IsInRole("Admin");
}

@* Caleb McIntyre - 13/11/2026: heading and table box match the home page *@
<div class="sats-page-head">
    <p class="sats-eyebrow">Records</p>
    <h1>Course Records</h1>
    <h3> Current courses offered by the university.</h3>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success"> @TempData["Message"] </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"> @TempData["Error"] </div>
}

@if (isAdmin)
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Add Course</a>
    </p>
}

<!-- Filter and sort -->
<div class="d-flex flex-wrap gap-3 mb-3">
    <div style="width: 260px; max-width: 100%;">
        <label for="courseFilter" class="form-label">Filter by ID:</label>
        <select id="courseFilter" class="form-select">
            <option value="">All Courses</option>
            @foreach (var prefix in ViewBag.CoursePrefixes)
            {
                <option value="@prefix">@prefix</option>
            }
        </select>
    </div>
    <div style="width: 260px; max-width: 100%;">
        <label for="sortOrder" class="form-label">Sort by:</label>
        <select id="sortOrder" class="form-select">
            <option value="default">Default order</option>
            <option value="asc">Course ID (A to Z)</option>
            <option value="desc">Course ID (Z to A)</option>
        </select>
    </div>
</div>

<div class="table-responsive sats-table-wrap">
<table id="coursesTable" class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Course Name</th>
            <th>Teacher</th>
            @if (isAdmin)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="course-row" data-course-id="@item.Course.CourseId">
                <td>@item.Course.CourseId</td>
                <td>@item.Course.CourseName</td>   
                <td>@item.TeacherName</td>
                @if (isAdmin)
                {
                    <td>
                        <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Course.CourseId">Edit</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Course.CourseId">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
</div>


@* Caleb McIntyre - 13/11/2026: the Course Sessions table moved to the Course Sessions page *@

<script>
    document.getElementById("courseFilter").addEventListener("change", function () {

        const selectedPrefix = this.value.toUpperCase();

        
        document.querySelectorAll(".course-row").forEach(row => {

            const courseId = row.dataset.courseId.toUpperCase();
            row.style.display =
                selectedPrefix === "" || courseId.startsWith(selectedPrefix)
                    ? ""
                    : "none";
        });

    });

    // Caleb McIntyre - 13/11/2026: sort the table rows by course ID
    (function () {
        const sortSelect = document.getElementById("sortOrder");
        const tbody = document.querySelector("#coursesTable tbody");
        if (!sortSelect || !tbody) return;

        //Remember the original order so "Default order" can put it back
        Array.from(tbody.rows).forEach((row, index) => row.dataset.index = index);

        sortSelect.addEventListener("change", function () {
            const rows = Array.from(tbody.rows);
            rows.sort((a, b) => {
                if (this.value === "default") {
                    return a.dataset.index - b.dataset.index;
                }
                const compare = a.dataset.courseId.localeCompare(b.dataset.courseId, undefined, { numeric: true, sensitivity: "base" });
                //Same course: keep the original order
                const result = compare !== 0 ? compare : a.dataset.index - b.dataset.index;
                return this.value === "desc" ? -result : result;
            });
            rows.forEach(row => tbody.appendChild(row));
        });
    })();
</script>