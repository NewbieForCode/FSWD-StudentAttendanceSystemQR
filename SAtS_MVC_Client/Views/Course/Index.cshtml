@model List<SAtS_MVC_Client.Models.CourseViewModel>

@{
    // Caleb McIntyre - 12/11/2026: Admins see Add, Edit and Delete buttons
    ViewData["Title"] = "Course Records";
    var isAdmin = User.IsInRole("Admin");
}

<h1> Course Records </h1>
<h3> Current courses offered by the university.</h3>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success"> @TempData["Message"] </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"> @TempData["Error"] </div>
}

@if (isAdmin)
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Add Course</a>
    </p>
}

<!-- Filter -->
<form asp-controller="Course" asp-action="Index" method="get">
    <label for="courseFilter">Filter by ID:</label>

    <select id="courseFilter" class="form-select">
        <option value="">All Courses</option>

        @foreach (var prefix in ViewBag.CoursePrefixes)
        {
            <option value="@prefix">@prefix</option>
        }
    </select>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Course Name</th>
            <th>Teacher</th>
            @if (isAdmin)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="course-row" data-course-id="@item.Course.CourseId">
                <td>@item.Course.CourseId</td>
                <td>@item.Course.CourseName</td>   
                <td>@item.TeacherName</td>
                @if (isAdmin)
                {
                    <td>
                        <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@item.Course.CourseId">Edit</a>
                        <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Course.CourseId">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>


<br /> <br />
<h1> Course Sessions </h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Course ID</th>
            <th>Session ID</th>
            <th>Session Date</th>
            <th>QR Token</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            @foreach (var session in item.Sessions)
            {
                // Testing QR Code gen for the sessions 
                string qrContent = $"https://localhost:7147/api/CourseSession/{session.CSessionId}/qrcode";
                string qrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={Uri.EscapeDataString(qrContent)}";
                <tr class="session-row" data-course-id="@session.CourseId">
                    <td>@session.CourseId</td>
                    <td>@session.CSessionId</td>
                    <td>@session.CSessionDate</td>
                    <td>@session.CSessionQrtoken</td>
                    <td><img src="@qrUrl" alt="QR Code" width="30" height="30" /></td>
                    @if (isAdmin)
                    {
                        <td>
                            <a class="btn btn-secondary btn-sm" asp-action="EditSession" asp-route-id="@session.CSessionId">Edit</a>
                            <a class="btn btn-danger btn-sm" asp-action="DeleteSession" asp-route-id="@session.CSessionId">Delete</a>
                        </td>
                    }
                </tr>
            }
        }
        
    </tbody>
</table>

<script>
    document.getElementById("courseFilter").addEventListener("change", function () {

        const selectedPrefix = this.value.toUpperCase();

        
        document.querySelectorAll(".course-row").forEach(row => {

            const courseId = row.dataset.courseId.toUpperCase();
            row.style.display =
                selectedPrefix === "" || courseId.startsWith(selectedPrefix)
                    ? ""
                    : "none";
        });

        
        document.querySelectorAll(".session-row").forEach(row => {

            const courseId = row.dataset.courseId.toUpperCase();
            row.style.display =
                selectedPrefix === "" || courseId.startsWith(selectedPrefix)
                    ? ""
                    : "none";
        });
    });
</script>